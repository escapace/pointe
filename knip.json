{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["ncu"],
  "ignoreDependencies": ["@commitlint/cli"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "lefthook": {
    "config": []
  },
  "workspaces": {
    "packages/*": {
      "entry": ["src/{index,cli}.ts!"],
      "project": ["{src,scripts}/**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,vue}"]
    }
  }
}
